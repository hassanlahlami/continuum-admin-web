{
  "name": "continuum-admin-web",
  "version": "0.1.0",
  "description": "Continuum — Plateforme Admin Système (front). Contrat-first (D32), tokens --ct-* (§1.6).",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "compile:templates": "ngc -p tsconfig.app.json",
    "generate:admin-iam": "openapi-generator-cli generate -i ../Instructions/contracts/openapi/admin/tenancy-iam.yaml -g typescript-angular -o libs/api-clients/admin-iam --additional-properties=ngVersion=19.0.0,supportsES6=true,withInterfaces=true",
    "generate:auth": "openapi-generator-cli generate -i ../Instructions/contracts/openapi/public/auth.yaml -g typescript-angular -o libs/api-clients/auth --additional-properties=ngVersion=19.0.0,supportsES6=true,withInterfaces=true",
    "generate:operations": "redocly bundle ../Instructions/contracts/openapi/admin/operations.yaml -o .operations.bundled.yaml && openapi-generator-cli generate -i .operations.bundled.yaml -g typescript-angular -o libs/api-clients/operations --additional-properties=ngVersion=19.0.0,supportsES6=true,withInterfaces=true",
    "start": "ng serve --port 4201",
    "serve:mock": "ng serve --port 4201",
    "serve:live": "ng serve --configuration live --port 4201",
    "e2e:run": "cypress run --project e2e",
    "e2e:live": "cypress run --project e2e --config-file cypress.live.config.ts",
    "e2e:open": "cypress open --project e2e",
    "e2e": "start-server-and-test serve:mock http-get://localhost:4201 e2e:run"
  },
  "dependencies": {
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/router": "^19.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular/animations": "^19.2.25",
    "@angular/build": "^19.0.0",
    "@angular/cdk": "^19.2.19",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@angular/forms": "^19.2.25",
    "@angular/material": "^19.2.19",
    "@fontsource/roboto": "^5.3.0",
    "@openapitools/openapi-generator-cli": "^2.15.3",
    "@redocly/cli": "^2.72.1",
    "axe-core": "^4.14.0",
    "cypress": "^13.17.0",
    "cypress-axe": "^1.7.0",
    "material-symbols": "^0.48.0",
    "msw": "^2.15.0",
    "start-server-and-test": "^2.1.5",
    "typescript": "~5.6.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
